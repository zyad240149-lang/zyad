{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "meaad-static",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "serve",
        "."
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "meaad-react",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 4300,
      "autoPort": true
    },
    {
      "name": "meaad-prod-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--",
        "--port",
        "4310"
      ],
      "port": 4310,
      "autoPort": true
    }
  ]
}
