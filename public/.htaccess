# ميعاد — Apache config for shared hosting (Hostinger hPanel).
#
# Vite copies everything in public/ into dist/ verbatim, so this ships with every
# build. Upload the *contents* of dist/ into public_html/ — this file included
# (File Manager hides dotfiles until you enable "Show hidden files").
#
# The app must live at the domain root: index.html and the service worker both
# reference /_ds/... and /assets/... absolutely, so a subfolder deploy breaks them.

# ------------------------------------------------------------------
# SPA routing
#
# react-router handles /login, /dashboard, /account, /book and friends in the
# browser. Apache knows nothing about them, so without this a visitor who opens
# such a URL directly — or just refreshes the page — gets a 404.
# ------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Anything that exists on disk (assets, icons, _ds, manifest, sw.js) is served
  # as itself — only unknown paths fall through to the app.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>

# HTTPS is deliberately not forced here — turn on "Force HTTPS" in hPanel instead.
# Doing both writes two competing rule sets and can cause a redirect loop.

# ------------------------------------------------------------------
# Caching
# ------------------------------------------------------------------
<IfModule mod_headers.c>
  # Build output carries a content hash in its filename, and the design system is
  # pinned by the UUID in its folder name — both are safe to keep for a year.
  <FilesMatch "\.(js|css|woff2?|ttf|png|jpg|jpeg|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # These three decide which version a returning visitor gets. If they were cached,
  # a deploy could leave someone on the old app indefinitely.
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # This app shows patient records: don't leak URLs to third parties, don't let it
  # be framed, don't let a response be re-interpreted as a different content type.
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript \
    application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

# A missing asset should read as missing, not as the app shell.
ErrorDocument 404 /index.html
